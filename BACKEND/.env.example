# ── Database (Neon PostgreSQL) ──────────────────────────────────────────────
# Neon dashboard → Connection Details.
# Pooled connection string (host contains "-pooler"), used by the running API:
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
# Direct (non-pooled) connection string, used by Prisma migrations:
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

    
# ── Server ─────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=production
# Comma-separated list of allowed frontend origins (exact, no trailing slash)
CORS_ORIGINS="https://YOUR-FRONTEND-DOMAIN"

# ── Auth ───────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="paste-a-long-random-string-here"
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
# Frontend and backend on different domains (typical deploy): none + true (HTTPS required)
# Same site (e.g. app.example.com + api.example.com): lax + true
COOKIE_SAMESITE=none
COOKIE_SECURE=true

# ── Business ───────────────────────────────────────────────────────────────
BUSINESS_TIMEZONE="Asia/Manila"

